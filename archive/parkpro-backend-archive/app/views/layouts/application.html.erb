<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=Edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= content_for?(:title) ? yield(:title) : "Spots - Sign In" %></title>
    <%= csrf_meta_tags %>

    <!-- Le HTML5 shim, for IE6-8 support of HTML elements -->
    <!--[if lt IE 9]>
      <script src="http://html5shim.googlecode.com/svn/trunk/html5.js" type="text/javascript"></script>
    <![endif]-->

    <%= stylesheet_link_tag "application", :media => "all" %>

   <!--  -->
  </head>
  <body>

    <div class="navbar navbar-fixed-top navbar navbar-inverse">
      <div class="navbar-inner">
        <div class="container">
          <a class="btn btn-navbar" data-target=".nav-collapse" data-toggle="collapse">
            <span class="icon-bar"></span>
            <span class="icon-bar"></span>
            <span class="icon-bar"></span>
          </a>

          <%= link_to "Spots", spots_path , class: "brand" %>
          <div class="container nav-collapse">
            <ul class="nav ">
              <li class="divider-vertical"></li>
              <li><%= link_to "Rentals", "/a"  %></li>
              <li class="divider-vertical"></li>
              <li><%= link_to "My Spots", "/b"  %></li>
              <li class="divider-vertical"></li>
              <li><%= link_to "Cars", "/c"  %></li>
            </ul>
            <% if user_signed_in? %>
            <ul class="nav pull-right">
              <li class="dropdown">
                 <a data-toggle="dropdown" class="dropdown-toggle" href="#"> 
                  <%= current_user.email %>

                  <b class="caret"></b></a>
                   <ul class="dropdown-menu pull-right">
                  <li><%= link_to edit_user_registration_path do %> 
                    <i class=" icon-user"></i> My Profile
                      <% end %></li>             


                   <li class="divider"></li>
                   <li><%= link_to "Sign out", destroy_user_session_path, :method => :delete %></li>
                    </ul>
               </li>
            </ul>
            <% end %>
          </div><!--/.nav-collapse -->
          
        </div>
      </div>
    </div>

    <div class="container">
      <div class="content">
     
        <div class="row">
  
            <div class="span11">
    
                <%= yield %>
              </div>
        </div><!--/row-->
      </div><!--/content-->
   
      <footer>
        <p>&copy; 2012 Bixby Apps </p>
      </footer>

    </div> <!-- /container -->

    <!-- Javascripts
    ================================================== -->
    <!-- Placed at the end of the document so the pages load faster -->
    <%= javascript_include_tag "application" %>

  </body>
</html>